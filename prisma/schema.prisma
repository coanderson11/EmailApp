datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================
// ORIGINAL MODELS (Keep for existing tools)
// ============================================

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  microsoftId      String    @unique
  accessToken      String
  refreshToken     String
  tokenExpiry      DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  agentSettings    AgentSettings?
  agentActivities  AgentActivity[]
  drafts           Draft[]
  tasks            Task[]
  meetings         Meeting[]
  emails           Email[]
  meetingPreps     MeetingPrep[]
  
  // New: Extensibility tracking
  opportunities    ExtensionOpportunity[]
  activities       Activity[]
}

model AgentSettings {
  id                      String    @id @default(uuid())
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled                 Boolean   @default(false)
  autoProcessEmails       Boolean   @default(true)
  autoGenerateDrafts      Boolean   @default(true)
  autoExtractMeetings     Boolean   @default(true)
  requireApprovalForSend  Boolean   @default(true)
  checkIntervalMinutes    Int       @default(15)
  lastProcessedAt         DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model AgentActivity {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionType  String
  description String
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([userId, actionType])
  @@index([createdAt])
}

model Email {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlookId   String    @unique
  subject     String
  from        String
  body        String
  receivedAt  DateTime
  processed   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([userId, processed])
}

model Draft {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailId         String?
  subject         String
  body            String
  toRecipients    String
  ccRecipients    String?
  recipientTo     String?
  status          String    @default("draft")
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, status])
}

model Task {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailId     String?
  title       String
  description String?
  dueDate     DateTime?
  priority    String   @default("medium")
  category    String?
  status      String   @default("todo")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
}

model Meeting {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailId     String?
  title       String
  startTime   DateTime
  endTime     DateTime
  location    String
  attendees   String
  description String
  agenda      String?
  category    String?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model MeetingPrep {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetingId       String
  contextSources  String
  prepDocument    String
  summary         String?
  keyPoints       String?
  suggestedTopics String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, meetingId])
}

// ============================================
// NEW: COPILOT EXTENSIBILITY MODELS
// ============================================

model ExtensionOpportunity {
  id                  String                @id @default(uuid())
  userId              String
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  companyName         String
  industry            String
  companySize         String?
  location            String?
  
  domainExpertise     String
  hasData             Boolean               @default(false)
  hasTechCapability   Boolean               @default(false)
  
  microsoftRelationship String
  m365Usage           String?
  
  extensionIdea       String
  targetMarket        String?
  potentialValue      String?
  
  opportunityScore    Int                   @default(50)
  priority            String                @default("medium")
  
  stage               String                @default("identified")
  status              String                @default("active")
  
  discoveredDate      DateTime              @default(now())
  discoverySource     String
  lastActivityDate    DateTime?
  nextAction          String?
  nextActionDate      DateTime?
  
  notes               String?
  crmId               String?
  
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  
  contacts            ExtensionContact[]
  activities          Activity[]
  insights            Insight[]
  
  @@index([userId, stage])
  @@index([opportunityScore])
  @@index([industry])
  @@index([priority])
}

model ExtensionContact {
  id                  String                @id @default(uuid())
  opportunityId       String
  opportunity         ExtensionOpportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  
  name                String
  title               String
  role                String?
  linkedInUrl         String?
  email               String?
  phone               String?
  
  warmIntroPath       String?
  relationshipStrength String?
  mutualConnections   Int                   @default(0)
  
  outreachStatus      String                @default("not_contacted")
  lastContactDate     DateTime?
  lastContactType     String?
  
  linkedInActive      Boolean               @default(false)
  recentActivity      String?
  
  notes               String?
  
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  
  @@index([opportunityId])
  @@index([outreachStatus])
}

model Activity {
  id                  String                @id @default(uuid())
  userId              String
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId       String?
  opportunity         ExtensionOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  
  type                String
  date                DateTime
  summary             String
  content             String?
  
  sourceType          String
  sourceRef           String?
  
  sentiment           String?
  extractedTopics     String?
  extractedCommitments String?
  actionItems         String?
  
  createdAt           DateTime              @default(now())
  
  @@index([opportunityId, date])
  @@index([type])
  @@index([userId, date])
}

model Insight {
  id                  String                @id @default(uuid())
  opportunityId       String?
  opportunity         ExtensionOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  
  source              String
  insightType         String
  title               String
  content             String
  
  relevance           String                @default("medium")
  industry            String?
  
  metadata            String?
  
  date                DateTime              @default(now())
  
  @@index([opportunityId])
  @@index([source])
  @@index([insightType])
  @@index([industry])
}

model CustomerExtensionRequest {
  id                  String    @id @default(uuid())
  userId              String
  
  customerName        String
  industry            String?
  requestDescription  String
  painPoint           String?
  
  requestedDate       DateTime  @default(now())
  source              String
  
  potentialPartners   String?
  matched             Boolean   @default(false)
  matchedOpportunityId String?
  
  status              String    @default("open")
  priority            String    @default("medium")
  
  @@index([userId, status])
  @@index([industry])
}

model AgentQueryCache {
  id                  String    @id @default(uuid())
  
  agentType           String
  query               String
  response            String
  
  queryDate           DateTime  @default(now())
  expiresAt           DateTime
  
  @@index([agentType, query])
}
